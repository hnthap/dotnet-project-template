<Project>
  <PropertyGroup>
    <!-- Type safety -->
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1900;NU1901;NU1902</WarningsNotAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Lets IDE0005 (unnecessary using) be reported at build time... -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- ...without requiring XML docs on every public member -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Reproducible restores: commit packages.lock.json -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Vulnerability audit at restore, including transitive packages -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>

    <!-- Miscellaneous -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    An editor on Windows and builds in WSL share this folder, and restore writes
    OS-specific paths into obj/. Windows builds get their own bin/ and obj/.
  -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <BaseOutputPath>bin/windows/</BaseOutputPath>
    <BaseIntermediateOutputPath>obj/windows/</BaseIntermediateOutputPath>
    <!-- Keep the files WSL generates in bin/ and obj/ out of the Windows build -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
